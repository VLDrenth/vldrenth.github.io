---
import BaseLayout from '../layouts/BaseLayout.astro';

const education = [
  {
    dates: 'Sep 2026 – present',
    institution: 'University of Chicago Booth School of Business',
    degree: 'PhD, Econometrics and Statistics',
    logo: '/images/education/chicago-booth.svg',
  },
  {
    dates: 'Oct 2023 – Sep 2024',
    institution: 'University of Oxford',
    degree: 'MSc, Statistical Science',
    logo: '/images/education/oxford.svg',
  },
  {
    dates: 'Sep 2020 – Jul 2023',
    institution: 'Erasmus University Rotterdam',
    degree: 'BSc, Econometrics and Operations Research',
    logo: '/images/education/erasmus.svg',
  },
];

const teachingCourses = [
  'Introduction to Analysis',
  'Matrix Algebra',
  'Analysis',
  'Probability Theory',
  'Statistics',
];
---

<BaseLayout title="Vincent Drenth">
  <div class="container profile">
    <section id="about" aria-labelledby="profile-name">
      <header class="profile-header">
        <h1 id="profile-name">Vincent Drenth</h1>
        <p class="profile-subtitle">PhD Student at Chicago Booth</p>
      </header>

      <div class="profile-intro">
        <div class="biography">
          <p>
            I am a first-year PhD student in Econometrics and Statistics at the University of Chicago Booth School of Business.
          </p>
          <p>
            Previously, I completed an MSc in Statistics at the University of Oxford, where I worked on Bayesian active learning for my dissertation under the supervision of <a href="https://www.robots.ox.ac.uk/~twgr/">Tom Rainforth</a> and <a href="https://www.blackhc.net/">Andreas Kirsch</a>. I obtained my BSc in Econometrics and Operations Research from Erasmus University Rotterdam, where I worked as a research assistant with <a href="https://personal.eur.nl/alfons/">Andreas Alfons</a> on robust statistical methods for rating-scale data. Before Booth, I worked on macroeconomic forecasting with machine learning at a startup in London.
          </p>
          <ul class="contact-links" aria-label="Contact and profiles">
            <li><a href="mailto:vdrenth@chicagobooth.edu">Email</a></li>
            <li><a href="https://github.com/vldrenth" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a></li>
            <li><a href="https://linkedin.com/in/vincentdrenth" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a></li>
          </ul>
        </div>
        <img class="profile-photo" src="/images/vincent-chicago.jpg" alt="Vincent Drenth in Chicago" width="560" height="700" />
      </div>
    </section>

    <section id="research-interests" class="background-section" aria-labelledby="interests-heading">
      <h2 id="interests-heading">Research interests</h2>
      <p class="interests-description">
        I’m broadly interested in using machine learning to improve statistical inference, as well as developing statistical methods to understand and evaluate machine learning systems. I’m especially interested in uncertainty quantification and Bayesian methods.
      </p>
    </section>

    <section id="education" class="background-section" aria-labelledby="education-heading">
      <h2 id="education-heading" class="section-heading">Education</h2>
      <ul class="entry-list">
        {education.map(item => (
          <li class="background-entry education-entry">
            <img class="education-logo" src={item.logo} alt={`${item.institution} logo`} width="96" height="80" loading="lazy" />
            <div>
              <h3>{item.institution}</h3>
              <p class="entry-detail">{item.degree}</p>
              <p class="entry-dates education-dates">{item.dates}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section id="experience" class="background-section" aria-labelledby="experience-heading">
      <h2 id="experience-heading" class="section-heading">Experience</h2>
      <ul class="entry-list">
        <li class="background-entry experience-entry">
          <img class="experience-logo" src="/images/education/turnleaf-analytics.png" alt="Turnleaf Analytics logo" width="96" height="80" loading="lazy" />
          <div>
            <h3>Turnleaf Analytics</h3>
            <p class="entry-detail">Data Scientist</p>
            <p class="entry-dates experience-dates">Sep 2024 – Jun 2026</p>
          </div>
        </li>
      </ul>
    </section>

    <section id="teaching" class="background-section" aria-labelledby="teaching-heading">
      <h2 id="teaching-heading" class="section-heading">Teaching</h2>
      <ul class="entry-list">
        <li class="background-entry teaching-entry">
          <img class="experience-logo" src="/images/education/erasmus.svg" alt="Erasmus University Rotterdam logo" width="96" height="80" loading="lazy" />
          <div>
            <h3>Erasmus University Rotterdam</h3>
            <p class="entry-detail">Teaching Assistant</p>
            <p class="entry-dates experience-dates">Sep 2022 – Jul 2023</p>
            <p class="entry-description">{teachingCourses.join(', ')}</p>
          </div>
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .profile-header { margin-bottom: 32px; }

  .profile-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(200px, calc(100vw - 500px), 210px);
    align-items: start;
    gap: 32px;
  }
  .profile-header h1 { margin-bottom: 10px; }

  .profile-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center top;
    border-radius: 4px;
  }

  .profile-subtitle {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .biography { color: var(--text-secondary); }
  .biography p { margin-bottom: 18px; }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    font-size: 0.875rem;
  }

  .contact-links span { font-size: 0.75rem; }
  .interests-description { color: var(--text-secondary); margin: 0; }
  .background-section { margin-top: 48px; }

  .entry-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 28px;
  }

  .background-entry {
    display: grid;
    grid-template-columns: 156px minmax(0, 1fr);
    gap: 28px;
  }

  .education-entry {
    grid-template-columns: 96px minmax(0, 1fr);
    align-items: center;
    gap: 24px;
  }

  .education-logo {
    width: 96px;
    height: 80px;
    object-fit: contain;
  }

  .education-dates { margin: 6px 0 0; }

  .experience-logo {
    width: 96px;
    height: 80px;
    object-fit: contain;
  }

  .experience-entry {
    grid-template-columns: 96px minmax(0, 1fr);
    align-items: center;
    gap: 24px;
  }

  .experience-dates { margin: 6px 0 0; }

  .entry-dates {
    padding-top: 2px;
    color: var(--text-muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }

  .background-entry h3 { line-height: 1.5; }

  .entry-detail,
  .entry-description {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    margin: 0;
  }

  .entry-description {
    color: var(--text-muted);
    font-size: 0.875rem;
    margin-top: 4px;
  }

  .teaching-entry {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    align-items: center;
    gap: 24px;
  }

  @media (max-width: 600px) {
    .profile-intro { grid-template-columns: 1fr; gap: 28px; }
    .profile-photo {
      grid-row: 1;
      justify-self: center;
      width: 160px;
    }
    .background-section { margin-top: 40px; }
    .background-entry { grid-template-columns: 1fr; gap: 6px; }
    .entry-dates { padding: 0; }
    .education-entry { grid-template-columns: 64px minmax(0, 1fr); gap: 16px; }
    .education-logo { width: 64px; height: 64px; }
    .experience-entry { grid-template-columns: 64px minmax(0, 1fr); gap: 16px; }
    .experience-logo { width: 64px; height: 64px; }
    .teaching-entry { grid-template-columns: 64px minmax(0, 1fr); gap: 16px; }
  }
</style>
