---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Vincent Drenth">
  <div class="container">
    <section class="hero">
      <h1 class="hero-name">Vincent Drenth</h1>
      <p class="hero-tagline">
        <span class="tagline-accent">statistics</span> <span class="dot">&middot;</span>
        <span class="tagline-accent">econometrics</span> <span class="dot">&middot;</span>
        <span class="tagline-accent">machine learning</span>
      </p>
      <p class="hero-description">
        This site is a place to write up or archive anything I find interesting enough to share or keep.
      </p>
      <img src="/wavy-rule.svg" class="hero-rule" width="140" height="12" alt="" />
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    padding: 72px 0 40px;
  }

  .hero-name {
    font-size: var(--fs-3xl);
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-weight: 600;
    margin: 0 0 20px;
    color: var(--ink);
    margin-top: 0;
  }

  .hero-tagline {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--ink-2);
    margin: 0 0 var(--s-5);
    line-height: 1.5;
  }

  .dot {
    color: var(--ink-3);
    margin: 0 2px;
  }

  .tagline-accent {
    color: var(--rust);
  }

  .hero-description {
    font-family: var(--font-serif);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--ink-2);
    margin: 0;
    max-width: 560px;
  }

  .hero-rule {
    display: block;
    margin-top: var(--s-7);
    opacity: 0.7;
    border: none;
    border-radius: 0;
  }

  @media (max-width: 768px) {
    .hero-name {
      font-size: 2.5rem;
    }

    .hero {
      padding: 48px 0 32px;
    }
  }
</style>
