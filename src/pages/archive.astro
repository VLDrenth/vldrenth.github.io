---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const items = await getCollection('archive');

const categories = ['ML', 'Stats', 'Econ', 'Software'] as const;
const grouped = categories.map(cat => ({
  name: cat,
  items: items
    .filter(item => item.data.category === cat)
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
})).filter(group => group.items.length > 0);
---

<BaseLayout title="Archive | Vincent Drenth">
  <div class="container">
    <header class="page-header">
      <h1 class="page-title">Archive</h1>
      <p class="page-description">
        Papers, articles, and resources I've found interesting.
      </p>
    </header>

    <div class="archive-content">
      {grouped.length === 0 && (
        <p class="empty-state">Nothing here yet.</p>
      )}
      {grouped.map((group) => (
        <section class="category-section">
          <h2 class="category-title">{group.name}</h2>
          <ul class="items-list">
            {group.items.map((item) => (
              <li class="archive-item">
                <div class="item-row">
                  <a href={item.data.link} target="_blank" rel="noopener" class="item-link">
                    {item.data.title} <span class="external-icon">&#8599;</span>
                  </a>
                  <time class="item-date" datetime={item.data.date.toISOString().slice(0, 10)}>
                    {item.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}
                  </time>
                </div>
                {item.data.description && (
                  <p class="item-description">{item.data.description}</p>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page-header { margin-bottom: 40px; }
  .page-title { margin-bottom: 10px; }
  .page-description { color: var(--text-muted); margin: 0; }
  .archive-content { display: grid; gap: 40px; }

  .category-title {
    margin-bottom: 24px;
    font-size: 0.875rem;
    color: var(--text-muted);
    letter-spacing: 0;
  }

  .items-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 32px;
  }

  .item-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  .item-link { font-size: 1rem; font-weight: 600; }
  .external-icon { font-size: 0.8125rem; }

  .item-date {
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .item-description {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    margin: 10px 0 0;
  }

  .empty-state { color: var(--text-muted); }
</style>
