---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Vincent Drenth — PhD student in Econometrics and Statistics at the University of Chicago Booth School of Business." } = Astro.props;
const pathname = Astro.url.pathname;
const isHome = pathname === '/';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <script is:inline>
      (() => {
        let theme;
        try { theme = sessionStorage.getItem('theme'); } catch {}
        document.documentElement.dataset.theme = theme === 'light' || theme === 'dark'
          ? theme : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      })();
    </script>
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="container">
        <nav class="nav-inner" aria-label="Main navigation">
          <a href="/" class="wordmark" aria-label="Vincent Drenth — home">VD</a>
          <div class="nav-links">
            <a href="/" aria-current={isHome ? 'page' : undefined}>About</a>
            <a href="/#education">Education</a>
            <a href="/#experience">Work experience</a>
            <a href="/#teaching">Teaching</a>
            <button class="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false" title="Toggle dark mode" hidden>
              <svg class="theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
              </svg>
              <svg class="theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z" />
                <path d="M18 2v4m-2-2h4" />
              </svg>
            </button>
          </div>
        </nav>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer container">
      <div class="footer-inner">
        <span>&copy; {new Date().getFullYear()} Vincent Drenth</span>
        <div class="footer-links">
          <a href="mailto:vdrenth@chicagobooth.edu">Email</a>
          <a href="https://github.com/vldrenth" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="https://linkedin.com/in/vincentdrenth" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </div>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      if (toggle) {
        const root = document.documentElement;
        const sync = () => toggle.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
        sync();
        toggle.hidden = false;
        let revealing = false;
        toggle.addEventListener('click', async () => {
          if (revealing) return;
          const applyTheme = () => {
            const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
            root.dataset.theme = theme;
            try { sessionStorage.setItem('theme', theme); } catch {}
            sync();
          };
          if (!document.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches) {
            root.classList.add('theme-ready');
            applyTheme();
            return;
          }
          const bounds = toggle.getBoundingClientRect();
          const x = bounds.left + bounds.width / 2;
          const y = bounds.top + bounds.height / 2;
          const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
          revealing = true;
          root.classList.add('theme-revealing');
          const transition = document.startViewTransition(applyTheme);
          try {
            await transition.ready;
            await root.animate({
              clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`],
            }, {
              duration: 360,
              easing: 'cubic-bezier(.2,.7,.3,1)',
              pseudoElement: '::view-transition-new(root)',
            }).finished;
          } catch {
            // A skipped transition still applies the new theme.
          } finally {
            transition.skipTransition();
            await transition.finished;
            root.classList.remove('theme-revealing');
            revealing = false;
          }
        });
      }
    </script>
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
  }

  .skip-link {
    position: fixed;
    top: -100px;
    left: 20px;
    z-index: 200;
    padding: 8px 16px;
    background: var(--background);
  }

  .skip-link:focus { top: 8px; }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--background);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 76px;
    border-bottom: 1px solid var(--border);
  }

  .wordmark {
    color: var(--text);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 26px;
    font-size: 0.875rem;
  }

  .nav-links a { color: var(--text-muted); }

  .theme-toggle {
    view-transition-name: theme-toggle;
    position: relative;
    display: grid;
    place-items: center;
    flex: 0 0 36px;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .theme-toggle[hidden] { display: none; }
  .theme-toggle:hover { color: var(--text); background: var(--toggle-hover); }
  .theme-toggle svg { position: absolute; width: 20px; height: 20px; }
  .theme-moon { opacity: 0; transform: rotate(-65deg) scale(0.5); }
  :global([data-theme='dark']) .theme-sun { opacity: 0; transform: rotate(90deg) scale(0.5); }
  :global([data-theme='dark']) .theme-moon { opacity: 1; transform: rotate(0) scale(1); }
  @media (prefers-reduced-motion: no-preference) {
    .theme-toggle svg { transition: transform 240ms cubic-bezier(.2,.8,.2,1), opacity 160ms ease; }
    :global(.theme-ready) .site-header { transition: background-color 180ms ease; }
  }
  .nav-links a:hover,
  .nav-links a[aria-current='page'] { color: var(--text); }

  .nav-links a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  main {
    flex: 1;
    width: 100%;
    padding: 60px 0 72px;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    border-top: 1px solid var(--border);
    padding: 24px 0;
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .footer-links {
    display: flex;
    gap: 20px;
  }

  .footer-links a { color: var(--text-muted); }

  @media (max-width: 600px) {
    .nav-inner { min-height: 68px; gap: 20px; }
    .nav-links { gap: 18px; font-size: 0.8125rem; }
    main { padding: 40px 0 56px; }
    .footer-inner { flex-wrap: wrap; gap: 12px; }
  }

  @media (max-width: 380px) {
    .wordmark { display: none; }
    .nav-links { width: 100%; justify-content: space-between; gap: 12px; }
  }
</style>
