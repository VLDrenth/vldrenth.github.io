---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Vincent Drenth — PhD student in Econometrics and Statistics at the University of Chicago Booth School of Business." } = Astro.props;
const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const isArchive = pathname.startsWith('/archive');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="container">
        <nav class="nav-inner" aria-label="Main navigation">
          <a href="/" class="wordmark" aria-label="Vincent Drenth — home">VD</a>
          <div class="nav-links">
            <a href="/" aria-current={isHome ? 'page' : undefined}>About</a>
            <a href="/#education">Education</a>
            <a href="/#experience">Experience</a>
            <a href="/archive/" aria-current={isArchive ? 'page' : undefined}>Archive</a>
          </div>
        </nav>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer container">
      <div class="footer-inner">
        <span>&copy; {new Date().getFullYear()} Vincent Drenth</span>
        <div class="footer-links">
          <a href="mailto:vdrenth@chicagobooth.edu">Email</a>
          <a href="https://github.com/vldrenth" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="https://linkedin.com/in/vincentdrenth" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
  }

  .skip-link {
    position: fixed;
    top: -100px;
    left: 20px;
    z-index: 200;
    padding: 8px 16px;
    background: var(--background);
  }

  .skip-link:focus { top: 8px; }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--background);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 76px;
    border-bottom: 1px solid var(--border);
  }

  .wordmark {
    color: var(--text);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .nav-links {
    display: flex;
    gap: 26px;
    font-size: 0.875rem;
  }

  .nav-links a { color: var(--text-muted); }
  .nav-links a:hover,
  .nav-links a[aria-current='page'] { color: var(--text); }

  .nav-links a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  main {
    flex: 1;
    width: 100%;
    padding: 60px 0 72px;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    border-top: 1px solid var(--border);
    padding: 24px 0;
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .footer-links {
    display: flex;
    gap: 20px;
  }

  .footer-links a { color: var(--text-muted); }

  @media (max-width: 600px) {
    .nav-inner { min-height: 68px; gap: 20px; }
    .nav-links { gap: 18px; font-size: 0.8125rem; }
    main { padding: 40px 0 56px; }
    .footer-inner { flex-wrap: wrap; gap: 12px; }
  }

  @media (max-width: 380px) {
    .wordmark { display: none; }
    .nav-links { width: 100%; justify-content: space-between; gap: 12px; }
  }
</style>
